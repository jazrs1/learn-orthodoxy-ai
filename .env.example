OPENAI_API_KEY=sk-your-openai-key
CHROMA_DIR=chroma_db
# Corpus: v1 (default) or v2 (Phase 5, INGEST_PLAN.md §9). v2 lives in CHROMA_DIR_V2, default
# <CHROMA_DIR>/v2 (inside the Railway volume); startup refuses v2 unless it matches its manifest.
# CORPUS_VERSION=v1
# CHROMA_DIR_V2=
# SAINT_ENTRY_MAX_CHUNKS=3
AUTO_INGEST_ON_START=1
MIN_CHROMA_DOCUMENTS=1000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Hardening (required) ---
# Shared secret the Next.js server routes send as X-Internal-Key. The API refuses
# every request except /health without it. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me
# Expose /debug/* endpoints (never in production)
ENABLE_DEBUG=0

# --- Hardening (optional, defaults shown) ---
# MAX_QUESTION_CHARS=1000
# ANSWER_MAX_TOKENS=1200
# OPENAI_TIMEOUT_SECONDS=25
# OPENAI_MAX_RETRIES=1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# CHAT_RATE_LIMIT_PER_MINUTE=20
# CHAT_GLOBAL_RATE_LIMIT_PER_MINUTE=300

# --- Retrieval and generation (optional, defaults shown; see DECISIONS.md phase 4) ---
# Recommended for production: OPENAI_CHAT_MODEL=gpt-4.1-mini (GEN-005)
# PROMPT_VERSION=v3
# VECTOR_DISTANCE_THRESHOLD=1.25
# ARABIC_VECTOR_DISTANCE_THRESHOLD=0
# ANSWER_MAX_TOKENS_TASK=2400
# TASK_ANALYSIS_ENABLED=1
# TASK_ANALYSIS_MODEL=gpt-4o-mini
# TASK_ANALYSIS_TIMEOUT_SECONDS=8
# BROAD_RETRIEVAL_TOP_K=16
# BROAD_PER_QUERY_MIN=2
# SAINT_LIST_MAX_ENTRIES=30
# TRADITION_RETRIEVAL_TOP_K=6
# ENTITY_CHECK_ENABLED=1

# Next.js contact form / Vercel
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAILS=johnazer07@gmail.com,frjeromemaximous@gmail.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
