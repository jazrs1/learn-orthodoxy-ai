# Postgres for chat persistence (POSTGRES_URL or DATABASE_URL)
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# FastAPI backend. Server-side only; the browser never calls the backend directly.
ORTHODOX_API_URL=http://127.0.0.1:8001
# Must match INTERNAL_API_KEY on the backend. Generate with: openssl rand -hex 32
ORTHODOX_API_KEY=change-me

# Contact form (optional locally)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAILS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
